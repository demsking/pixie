{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": [
    "pre-commit@latest",
    "tmux@latest",
    "tmuxinator@latest",
    "gnumake@latest",
    "git@latest",
    "zlib@latest",
    "shellcheck@latest",
    "rustup@latest",
    "pkg-config@latest",
    "gtk4@latest",
    "gtk4.dev",
    "graphene@latest",
    "graphene.dev",
    "dav1d@latest",
    "dav1d.dev",
    "glib.dev",
    "libadwaita@latest",
    "libadwaita.dev",
    "mdbook@latest",
    "flatpak-builder@latest"
  ],
  "shell": {
    "init_hook": [
      "pre-commit install -f",
      "make bootstrap"
    ],
    "scripts": {
      "bootstrap":  "make bootstrap",
      "build":      "make build",
      "check":      "make check",
      "test":       "make test-all",
      "lint":       "make lint",
      "run":        "make run",
      "docs":       "make docs-build",
      "docs-serve": "make docs-serve",
      "flatpak":    "make flatpak-build",
      "ci":         "make ci"
    }
  }
}
